{
  "name": "competitive-intelligence-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Andwell Health Partners competitive service line intelligence hub for Hostinger managed Next.js hosting.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",

    "build:strict": "CIH_STRICT_BUILD=1 next build",
    "typecheck": "tsc --noEmit",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "serve": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "hostinger:start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "start:hostinger": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "start:custom": "node server.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
